# CamSec – Visor d'escriptori (cam_viewer.py)
# Copia aquest fitxer a .env i omple els valors del teu entorn:
#
#   cp .env.example .env
#
# El fitxer .env NO s'ha de pujar al control de versions.

# ── Broker MQTT ────────────────────────────────────────────────────────────
# IP o hostname de l'equip on corre el broker Mosquitto.
MQTT_BROKER=192.168.1.10

# Port TCP del broker (per defecte 1883).
MQTT_PORT=1883

# ── Autenticació MQTT (opcional) ───────────────────────────────────────────
# Deixa buit si el broker permet connexions anònimes.
MQTT_USER=
MQTT_PASS=
