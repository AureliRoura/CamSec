# CamSec – Environment variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to version control.

# ── Docker images ──────────────────────────────────────────────────────────
# Per usar les imatges publicades a GHCR (per defecte):
#   DETECTOR_IMAGE=ghcr.io/aureliRoura/camsec-detector:latest
#   VIEWER_IMAGE=ghcr.io/aureliRoura/camsec-viewer:latest
#
# Per usar les imatges de Docker Hub:
#   DETECTOR_IMAGE=aureliRoura/camsec-detector:latest
#   VIEWER_IMAGE=aureliRoura/camsec-viewer:latest
#
# Deixa buit per usar les imatges per defecte (GHCR)
DETECTOR_IMAGE=
VIEWER_IMAGE=

# ── External MQTT Broker ───────────────────────────────────────────────────
# IP address, hostname or container name of the existing MQTT broker.
# Use CAMSEC_MQTT_* names to avoid collisions with host-level MQTT_* variables.
#
# Common cases:
#   Same host, broker NOT in Docker → CAMSEC_MQTT_BROKER=127.0.0.1
#   Remote host                     → CAMSEC_MQTT_BROKER=192.168.1.10
# IP or hostname of the MQTT broker (external server)
CAMSEC_MQTT_BROKER=192.168.1.10
CAMSEC_MQTT_PORT=1883

# ── Detector credentials ───────────────────────────────────────────────────
# Leave empty if the broker allows anonymous connections.
DETECTOR_MQTT_USER=
DETECTOR_MQTT_PASS=

# ── Viewer credentials ─────────────────────────────────────────────────────
# Leave empty if the broker allows anonymous connections.
VIEWER_MQTT_USER=
VIEWER_MQTT_PASS=

# ── Logging ────────────────────────────────────────────────────────────────
# Valid values: DEBUG, INFO, WARNING, ERROR
DETECTOR_LOG_LEVEL=INFO
VIEWER_LOG_LEVEL=INFO

# ── Detector same-streak warning policy ────────────────────────────────────
# Publish <prefix>/alert/same when many consecutive <prefix>/image/same events
# happen after a person was previously detected.
SAME_PERSON_ALERT_THRESHOLD=5
SAME_PERSON_ALERT_STEP=5
